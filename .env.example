# Local Docker Postgres (see docker-compose.yml)
# DATABASE_URL="postgresql://crm:crm@127.0.0.1:5434/crm?schema=public"

# Production (Neon / Hostinger-compatible Postgres) — use the pooled URL if Neon gives one
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="https://saledek.com"
NEXTAUTH_URL="https://saledek.com"

# File uploads (local path; on Vercel this is ephemeral — use blob storage later)
UPLOAD_DIR="./uploads"

# Optional branding
NEXT_PUBLIC_PLATFORM_NAME="SaleDek"

# Optional SMTP (leave unset to mock emails in logs)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@saledek.com
# SMTP_MOCK=false
