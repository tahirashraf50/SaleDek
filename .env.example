# Local Docker MySQL (see docker-compose.yml) — port 3307 on host
# DATABASE_URL="mysql://crm:crm@127.0.0.1:3307/crm"

# Hostinger MySQL (same server as Node app → use 127.0.0.1)
# Encode @ in password as %40  e.g. Pass@word → Pass%40word
# Example:
# DATABASE_URL="mysql://u226394950_saledek_user:Saledek%40007@127.0.0.1:3306/u226394950_saledek"
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="https://saledek.com"
NEXTAUTH_URL="https://saledek.com"

# File uploads
UPLOAD_DIR="./uploads"

# Optional branding
NEXT_PUBLIC_PLATFORM_NAME="SaleDek"

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@saledek.com
# SMTP_MOCK=false
