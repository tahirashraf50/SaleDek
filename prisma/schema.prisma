generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  AGENT
  DEPARTMENT_USER
  VIEWER
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketChannel {
  PHONE
  WALK_IN
  EMAIL
  WHATSAPP
  PORTAL
  OTHER
}

enum TicketStageKey {
  NEW
  TRIAGED
  FORWARDED
  IN_PROGRESS
  WAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum DealStageKey {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum PaymentMethod {
  BANK
  JAZZCASH
  CHEQUE
  INSTALLMENT
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CLEARED
  BOUNCED
  PAID
  PARTIAL
  OVERDUE
}

enum OrderStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum UnderwritingStatus {
  PENDING
  IN_REVIEW
  POLICY_READY
  SENT
}

enum OrgModuleKey {
  UNDERWRITING
  FINANCE
  OPERATIONS
  SALES
  TECHNICAL
}

enum FinanceStatus {
  PENDING
  IN_REVIEW
  CLEARED
}

enum OperationsStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  STATUS_CHANGE
  ASSIGNMENT
  FORWARD
  ESCALATE
  PAYMENT
  SALE
  TICKET
  SYSTEM
}

enum AutomationTrigger {
  TICKET_CREATED
  TICKET_STAGE_CHANGED
  SLA_AT_RISK
  SLA_BREACHED
  SALE_CREATED
  INSTALLMENT_OVERDUE
  MESSAGE_RECEIVED
  CALL_LOGGED
}

enum OmniChannel {
  WHATSAPP
  EMAIL
  CALL
  PORTAL
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum CallOutcome {
  LOGGED
  COMPLAINT_CREATED
  SALE_CREATED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PlatformInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PlatformBillingEventType {
  INVOICE_SENT
  REMINDER
  FOLLOW_UP
  MARKED_PAID
  NOTE
}

enum SaaSPlanKey {
  DEMO
  STARTER
  PRO
  ENTERPRISE
}

model SaaSPlan {
  id                String      @id @default(cuid())
  key               SaaSPlanKey @unique
  name              String
  priceMonthly      Decimal     @db.Decimal(12, 2)
  description       String?
  features          Json
  maxUsers          Int         @default(5)
  maxTicketsPerMonth Int        @default(500)
  /// When set, assigning this plan starts a TRIAL for N days (e.g. Demo = 15)
  trialDays         Int?
  active            Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organizations Organization[]
  subscriptions OrgSubscription[]
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  /// Relative path under UPLOAD_DIR, e.g. {orgId}/branding/logo.png
  logoPath  String?
  /// ISO 4217 currency code for tenant money display (e.g. PKR, USD, AED)
  currency  String       @default("PKR")
  status    TenantStatus @default(TRIAL)
  planId    String?
  plan      SaaSPlan?    @relation(fields: [planId], references: [id])
  trialEndsAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users            User[]
  departments      Department[]
  teams            Team[]
  customers        Customer[]
  companies        Company[]
  tags             Tag[]
  customFields     CustomField[]
  ticketTypes      TicketType[]
  ticketStages     TicketStage[]
  tickets          Ticket[]
  slaPolicies      SlaPolicy[]
  knowledgeArticles KnowledgeArticle[]
  quickReplies     QuickReply[]
  products         Product[]
  dealStages       DealStage[]
  deals            Deal[]
  orders           Order[]
  automationRules  AutomationRule[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  savedViews       SavedView[]
  activities       Activity[]
  conversations    Conversation[]
  callLogs         CallLog[]
  channelConnectors ChannelConnector[]
  subscriptions    OrgSubscription[]
  platformInvoices PlatformInvoice[]
  productReviews   ProductReview[]
  modules          OrganizationModule[]
  ticketCounter    Int @default(1000)
  orderCounter     Int @default(1000)
  dealCounter      Int @default(1000)
}

model OrgSubscription {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           SaaSPlan           @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIAL)
  /// Billing period start
  startedAt      DateTime           @default(now())
  /// Planned renewal / next invoice date
  renewsAt       DateTime?
  /// Current period expiry
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  invoices       PlatformInvoice[]

  @@index([organizationId])
}

model PlatformInvoice {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   OrgSubscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String
  year           Int
  amount         Decimal               @db.Decimal(12, 2)
  status         PlatformInvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime?
  sentAt         DateTime?
  paidAt         DateTime?
  billingEmail   String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  events         PlatformBillingEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, year])
  @@index([organizationId, status])
}

model PlatformBillingEvent {
  id          String                   @id @default(cuid())
  invoiceId   String
  invoice     PlatformInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        PlatformBillingEventType
  toEmail     String?
  subject     String?
  body        String?
  mode        String?
  createdById String?
  createdAt   DateTime                 @default(now())

  @@index([invoiceId, createdAt])
}

model User {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(AGENT)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedCustomers   Customer[]       @relation("CustomerOwner")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  createdTickets   Ticket[]         @relation("TicketCreator")
  watchedTickets   TicketWatcher[]
  ticketNotes      TicketNote[]
  ownedDeals       Deal[]           @relation("DealOwner")
  createdOrders    Order[]          @relation("OrderCreator")
  underwritingOrders Order[]        @relation("OrderUnderwritingAssignee")
  financeOrders      Order[]        @relation("OrderFinanceAssignee")
  operationsOrders   Order[]        @relation("OrderOperationsAssignee")
  confirmedPayments Payment[]       @relation("PaymentConfirmer")
  notifications    Notification[]
  auditLogs        AuditLog[]
  activities       Activity[]
  teamMembers      TeamMember[]
  savedViews       SavedView[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  assignedConnectors ChannelConnector[] @relation("ConnectorAssignee")
  outboundMessages Message[]
  callLogs         CallLog[]

  @@index([organizationId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users    User[]
  tickets  Ticket[]
  teams    Team[]
  modules  OrganizationModule[]

  @@unique([organizationId, name])
}

model OrganizationModule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            OrgModuleKey
  enabled        Boolean      @default(false)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
  @@index([departmentId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  name           String
  createdAt      DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  ntn            String?
  strn           String?
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  postalCode     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers Customer[]

  @@index([organizationId, name])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  ownerId        String?
  owner          User?          @relation("CustomerOwner", fields: [ownerId], references: [id])
  name           String
  phone          String?
  email          String?
  cnic           String?
  address        String?
  city           String?
  source         String?
  status         CustomerStatus @default(LEAD)
  customData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tags         CustomerTag[]
  tickets      Ticket[]
  deals        Deal[]
  orders       Order[]
  activities   Activity[]
  notes        Note[]
  attachments  Attachment[]
  csatResponses CsatResponse[]
  conversations Conversation[]
  callLogs      CallLog[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([organizationId, email])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String @default("#0d9488")

  customers CustomerTag[]
  tickets   TicketTag[]

  @@unique([organizationId, name])
}

model CustomerTag {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model CustomField {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String // customer | ticket | deal | order
  name           String
  key            String
  fieldType      String @default("text") // text | number | select | date | boolean
  options        Json?
  required       Boolean @default(false)

  @@unique([organizationId, entity, key])
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body       String
  createdBy  String?
  createdAt  DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Optional reference label e.g. CNIC, Agreement, NTN, Policy
  label      String?
  fileName   String
  filePath   String
  mimeType   String?
  size       Int?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  type           ActivityType
  title          String
  body           String?
  meta           Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
}

model TicketType {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean @default(true)

  tickets Ticket[]
  slaPolicies SlaPolicy[]

  @@unique([organizationId, name])
}

model TicketStage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            TicketStageKey
  name           String
  position       Int
  isTerminal     Boolean @default(false)
  color          String  @default("#64748b")

  tickets Ticket[]

  @@unique([organizationId, key])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  subject        String
  description    String
  priority       TicketPriority @default(MEDIUM)
  channel        TicketChannel  @default(PHONE)
  stageId        String
  stage          TicketStage    @relation(fields: [stageId], references: [id])
  typeId         String?
  type           TicketType?    @relation(fields: [typeId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  assigneeId     String?
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdById    String?
  createdBy      User?          @relation("TicketCreator", fields: [createdById], references: [id])
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  resolutionNote String?
  firstRespondedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  customData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tags          TicketTag[]
  notes         TicketNote[]
  watchers      TicketWatcher[]
  linksFrom     TicketLink[] @relation("LinkFrom")
  linksTo       TicketLink[] @relation("LinkTo")
  slaTimers     SlaTimer[]
  csatResponses CsatResponse[]
  attachments   Attachment[]
  activities    Activity[]
  orders        Order[]

  @@unique([organizationId, number])
  @@index([organizationId, stageId])
  @@index([assigneeId])
  @@index([departmentId])
}

model TicketTag {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
}

model TicketNote {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model TicketWatcher {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
}

model TicketLink {
  id           String @id @default(cuid())
  fromTicketId String
  fromTicket   Ticket @relation("LinkFrom", fields: [fromTicketId], references: [id], onDelete: Cascade)
  toTicketId   String
  toTicket     Ticket @relation("LinkTo", fields: [toTicketId], references: [id], onDelete: Cascade)
  linkType     String @default("related") // related | duplicate | merged

  @@unique([fromTicketId, toTicketId])
}

model SlaPolicy {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  priority          TicketPriority?
  ticketTypeId      String?
  ticketType        TicketType?     @relation(fields: [ticketTypeId], references: [id])
  firstResponseMins Int
  resolveMins       Int
  active            Boolean @default(true)

  timers SlaTimer[]
}

model SlaTimer {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policyId        String
  policy          SlaPolicy @relation(fields: [policyId], references: [id])
  firstDueAt      DateTime
  resolveDueAt    DateTime
  firstBreached   Boolean   @default(false)
  resolveBreached Boolean   @default(false)
  firstMetAt      DateTime?
  resolveMetAt    DateTime?
}

model CsatResponse {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model KnowledgeArticle {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  category       String?
  body           String
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model QuickReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String
  shortcut       String?
  channel        OmniChannel?
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  unitPrice      Decimal  @db.Decimal(12, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  category       String?
  imageUrl       String?
  /// Sale form: JSON array of fields, or { fields, priceRule: { type:"percent_of_field", fieldId, percent } }
  formFields     Json?
  whatsappProductId String?
  catalogSyncedAt DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]
  tickets    Ticket[]
  reviews    ProductReview[]

  @@index([organizationId, name])
}

model ProductReview {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName     String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([organizationId])
}

model DealStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            DealStageKey
  name           String
  position       Int
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)
  color          String  @default("#64748b")

  deals Deal[]

  @@unique([organizationId, key])
}

model Deal {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  title          String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  stageId        String
  stage          DealStage @relation(fields: [stageId], references: [id])
  ownerId        String?
  owner          User?    @relation("DealOwner", fields: [ownerId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  value          Decimal  @default(0) @db.Decimal(12, 2)
  closeDate      DateTime?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders     Order[]
  activities Activity[]

  @@unique([organizationId, number])
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id])
  ticketId       String?
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  createdById    String?
  createdBy      User?         @relation("OrderCreator", fields: [createdById], references: [id])
  /// Agent assigned to create / issue the policy
  underwritingAssigneeId String?
  underwritingAssignee   User? @relation("OrderUnderwritingAssignee", fields: [underwritingAssigneeId], references: [id], onDelete: SetNull)
  financeAssigneeId String?
  financeAssignee   User? @relation("OrderFinanceAssignee", fields: [financeAssigneeId], references: [id], onDelete: SetNull)
  financeStatus     FinanceStatus @default(PENDING)
  operationsAssigneeId String?
  operationsAssignee   User? @relation("OrderOperationsAssignee", fields: [operationsAssigneeId], references: [id], onDelete: SetNull)
  operationsStatus     OperationsStatus @default(PENDING)
  operationsNote       String?
  paymentMethod  PaymentMethod
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  notes          String?
  /// Issued by Underwriting (e.g. POL-2026-000123)
  policyNumber   String?
  underwritingStatus UnderwritingStatus @default(PENDING)
  policyIssuedAt DateTime?
  policySentAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items        OrderItem[]
  payments     Payment[]
  installments Installment[]
  activities   Activity[]
  attachments  Attachment[]

  @@unique([organizationId, number])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, underwritingStatus])
  @@index([organizationId, policyNumber])
  @@index([organizationId, financeStatus])
  @@index([organizationId, operationsStatus])
  @@index([underwritingAssigneeId])
  @@index([financeAssigneeId])
  @@index([operationsAssigneeId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  /// Sale fill-blanks: JSON array of { id?, label, value }
  formValues  Json?
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  paidAt        DateTime?
  confirmedById String?
  confirmedBy   User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Installment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    Int
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  reference String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([orderId, number])
}

model AutomationRule {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  trigger        AutomationTrigger
  conditions     Json
  actions        Json
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  href           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entity         String?
  entityId       String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model SavedView {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?  @relation(fields: [userId], references: [id])
  name           String
  entity         String // tickets | customers | orders | deals
  filters        Json
  isShared       Boolean @default(false)
  createdAt      DateTime @default(now())
}

model Conversation {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        OmniChannel
  connectorId    String?
  connector      ChannelConnector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id])
  assigneeId     String?
  assignee       User?               @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  externalRef    String?
  subject        String?
  status         ConversationStatus  @default(OPEN)
  unreadCount    Int                 @default(0)
  lastMessageAt  DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages  Message[]
  callLogs  CallLog[]
  tickets   Ticket[]
  deals     Deal[]

  @@index([organizationId, channel, lastMessageAt])
  @@index([organizationId, status])
  @@index([connectorId])
  @@index([organizationId, connectorId, externalRef])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  subject        String?
  authorUserId   String?
  authorUser     User?            @relation(fields: [authorUserId], references: [id])
  meta           Json?
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([conversationId, sentAt])
}

model CallLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  agentId        String?
  agent          User?        @relation(fields: [agentId], references: [id])
  phone          String
  callerName     String?
  reason         String?
  notes          String?
  outcome        CallOutcome  @default(LOGGED)
  startedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, startedAt])
}

model ChannelConnector {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        OmniChannel
  name           String
  enabled        Boolean     @default(false)
  mode           String      @default("UI_ONLY") // UI_ONLY | WEBHOOK
  webhookSecret  String?
  /// phoneNumberId (WA) or fromEmail (EMAIL) — used to match inbound routing
  externalKey    String?
  config         Json?
  assigneeId     String?
  assignee       User?       @relation("ConnectorAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversations  Conversation[]

  @@index([organizationId])
  @@index([organizationId, channel])
  @@index([assigneeId])
  @@index([organizationId, externalKey])
}

/// Singleton row (id = "default") for public /site marketing website.
model PlatformWebsiteSettings {
  id                  String   @id @default("default")
  brandName           String   @default("SaleDek")
  logoPath            String?
  /// Base64 logo bytes (persists on Hostinger without local disk)
  logoData            String?  @db.LongText
  logoMime            String?
  heroBadge           String   @default("CRM & SaaS")
  heroHeadline        String   @default("Omnichannel complaints and sales in one workspace.")
  heroSubtext         String   @default("WhatsApp-style inbox, tickets, payments, shop, and portal — multi-tenant SaaS for every company you onboard.")
  heroCtaLabel        String   @default("Start free trial")
  heroCtaHref         String   @default("/register?plan=DEMO")
  heroSecondaryLabel  String   @default("View packages")
  heroSecondaryHref   String   @default("/pricing")
  /// [{ "value": "15d", "label": "Free demo" }, ...]
