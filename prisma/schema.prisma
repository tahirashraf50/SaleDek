  sectionTitle        String   @default("From first message to paid order")
  sectionBody         String   @default("Agents work one thread — convert to a complaint, a sale, or both without leaving the inbox.")
  midTitle            String   @default("Built for the teams who answer the phone")
  midBody             String   @default("Field service, telecom, retail — wherever complaints and sales collide. SaleDek keeps the conversation, the ticket, and the payment in sync.")
  analysisTitle       String   @default("Speed up your analysis")
  analysisBody        String   @default("Expand research across your organization with customization, security, and compliance features built with enterprise in mind.")
  /// string[]
  analysisBullets     Json     @default("[\"Automated renewal tracking and reminders\",\"Powerful filters and search to access information quickly\",\"Folder structure to stay organized\"]")
  /// string[]
  integrations        Json     @default("[\"WhatsApp\",\"Email\",\"JazzCash\",\"Portal\",\"Shop\",\"Slack\"]")
  integrationsTitle   String   @default("Connect with your favourite Apps")
  integrationsBody    String   @default("Keep your team members and customers in the loop by sharing your dashboard publicly or privately and receiving regular reports via email.")
  ctaTitle            String   @default("Stand up your tenant in minutes")
  ctaBody             String   @default("Pick a plan, create your org, and invite agents. Super admins manage every tenant from one console.")
  contactEmail        String   @default("info@yourmail.com")
  contactPhone        String   @default("(00) 99 222 99566")
  footerBlurb         String   @default("Multi-tenant complaint and sales workspace — inbox, tickets, payments, shop, and portal in one platform.")
  footerNote          String   @default("Built for service + sales teams")
  copyrightName       String   @default("SaleDek")
  /// Per-page SEO: { home|about|features|pricing|contact: { title, description, keywords } }
  seoPages            Json     @default("{}")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}
